{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "paths": {
      "##/*": [
        "./*"
      ],
      "#src/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "strict": true,
    "target": "esnext"
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts"
  ]
}
